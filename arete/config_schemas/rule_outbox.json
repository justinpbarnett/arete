{
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "enum": ["outbox"]
    },
    "enabled": {
      "type": "boolean"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["issue", "comment", "reply", "label", "status"]
      }
    },
    "audience": {
      "type": "string",
      "enum": ["self", "team", "client", "public"]
    },
    "drafter": {
      "type": "string",
      "enum": ["non-person", "agent", "system", "person", "any"]
    },
    "action": {
      "type": "string",
      "enum": ["approve", "draft"]
    }
  },
  "additionalProperties": false,
  "required": ["domain", "target", "audience", "drafter", "action"]
}
