{
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "type": {"type": "string", "enum": ["github", "jira", "log", "command", "closed-specs", "pipeline"]},
    "tracker": {"type": "string", "enum": ["github", "jira"]},
    "name": {"type": "string"},
    "enabled": {"type": "boolean"},
    "every": {"type": ["string", "number"]},
    "repos": {"$ref": "#/$defs/names"},
    "watch": {"$ref": "#/$defs/names"},
    "label": {"type": "string"},
    "branch": {"type": "string"},
    "jql": {"type": "string"},
    "limit": {"type": "integer"},
    "on_update": {"type": "boolean"},
    "repo": {"type": "string"},
    "path": {"type": "string"},
    "pattern": {"type": "string"},
    "command": {"$ref": "#/$defs/names"},
    "timeout": {"type": "number"},
    "trust": {"$ref": "#/$defs/trust"},
    "quarantine": {"type": ["boolean", "string"]},
    "line": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "why": {"type": "string"},
    "loop": {"type": "string"},
    "feeds": {"type": "string"},
    "connector": {"type": "string"}
  },
  "additionalProperties": false,
  "required": ["type"],
  "$defs": {
    "names": {"type": ["string", "array"], "items": {"type": "string"}},
    "trust": {"type": "string", "enum": ["untrusted", "internal", "owner"]}
  }
}
