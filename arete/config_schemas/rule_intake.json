{
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "enum": ["intake"]
    },
    "enabled": {
      "type": "boolean"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "match": {
      "type": "object",
      "properties": {
        "title_contains": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title_regex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "trust": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["untrusted", "internal", "owner"]
          }
        }
      },
      "additionalProperties": false
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "guidance": {
      "type": "string",
      "maxLength": 4000
    },
    "candidate_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["feat", "fix", "chore", "research", "bug", "task", "decision", "action_item"]
      }
    },
    "candidate_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["create", "link", "ignore"]
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": ["feat", "fix", "chore", "research", "bug", "task", "decision", "action_item"]
        },
        "action": {
          "type": "string",
          "enum": ["create", "link", "ignore"]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "task_permissions": {
      "type": "object",
      "properties": {
        "allow_create": {
          "type": "boolean"
        },
        "allow_link": {
          "type": "boolean"
        },
        "repos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "projects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": ["domain"]
}
