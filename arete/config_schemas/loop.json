{
  "type": "object",
  "properties": {
    "kind": {"type": "string", "enum": ["command", "watch", "search"]},
    "description": {"type": "string"},
    "enabled": {"type": "boolean"},
    "trigger": {
      "type": "object",
      "properties": {
        "every": {"type": ["string", "number"]},
        "cron": {"type": "string"},
        "run_at_load": {"type": "boolean"},
        "event": {"$ref": "source.json#/$defs/names"},
        "webhook": {"type": "boolean"},
        "group": {"type": "string"},
        "trust": {"$ref": "source.json#/$defs/trust"}
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "command": {"$ref": "source.json#/$defs/names"},
        "try_command": {"$ref": "source.json#/$defs/names"},
        "script": {"$ref": "source.json#/$defs/names"},
        "repo": {"type": "string"},
        "model": {"type": "string"},
        "runner": {"type": "string"},
        "tools": {"type": "array", "items": {"type": "string"}},
        "device": {"type": "string"},
        "timeout_minutes": {"type": "number"},
        "budget_usd": {"type": "number"},
        "daily_budget_usd": {"type": "number"},
        "queue": {"type": "string"},
        "stale_hours": {"type": "number"}
      },
      "additionalProperties": false
    },
    "source": {"type": "array", "items": {"$ref": "source.json"}},
    "search": {
      "type": "object",
      "properties": {
        "check": {"type": "string"},
        "iterations": {"type": "integer"},
        "files": {"type": "array", "items": {"type": "string"}},
        "proof": {"type": "string"}
      },
      "additionalProperties": false
    },
    "classify": {
      "type": "object",
      "properties": {
        "prompt": {"type": "string"},
        "model": {"type": "string"},
        "jev": {"type": "boolean"}
      },
      "additionalProperties": false,
      "required": ["prompt"]
    },
    "emit": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "enum": ["ticket", "pr", "push", "loop"]},
          "repo": {"type": "string"},
          "tracker": {"type": "string", "enum": ["github", "configured"], "description": "Ticket destination. Configured uses the registered repo's GitHub Issues or Jira project."},
          "labels": {"$ref": "source.json#/$defs/names"},
          "github_labels": {"$ref": "source.json#/$defs/names", "description": "Additional labels only on GitHub ticket destinations."},
          "prefix": {"type": "string"},
          "draft": {"type": "boolean"},
          "title": {"type": "string"},
          "check": {"type": "string"},
          "loop": {"type": "string"},
          "approve": {
            "type": ["boolean", "object"],
            "properties": {
              "lines": {"type": "integer"},
              "deletes": {"type": "boolean"},
              "paths": {"$ref": "source.json#/$defs/names"},
              "reviewer": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "required": ["type"]
      }
    }
  },
  "additionalProperties": false
}
