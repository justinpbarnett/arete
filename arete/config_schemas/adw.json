{
  "type": "object",
  "properties": {
    "schema": {"type": "integer", "enum": [1]},
    "name": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "items": {"type": "object"}
    },
    "node": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "step": {"type": "string", "minLength": 1},
          "finish": {"type": "string", "minLength": 1},
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "name": {"type": "string"},
          "model": {"type": "string"},
          "timeout": {"type": "integer", "minimum": 1},
          "when": {"type": "string", "enum": ["documents", "dry_run", "repo.parts", "feedback"]},
          "end": {"type": "boolean"},
          "inputs": {"type": "object"},
          "why": {"type": "string"},
          "detail": {"type": "string"}
        },
        "required": ["id", "x", "y"],
        "additionalProperties": false,
        "oneOf": [
          {"required": ["step"], "not": {"required": ["finish"]}},
          {"required": ["finish"], "not": {"required": ["step"]}}
        ]
      }
    },
    "wire": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"},
          "to": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"},
          "kind": {"type": "string", "enum": ["pass", "fail", "retry", "data"]},
          "label": {"type": "string"},
          "tries": {"type": "string", "pattern": "^setting:[a-z0-9_]+\\.tries$"},
          "min": {"type": "integer", "minimum": 0}
        },
        "required": ["from", "to", "kind"],
        "additionalProperties": false,
        "anyOf": [
          {"properties": {"kind": {"enum": ["retry"]}}},
          {
            "properties": {"kind": {"enum": ["pass", "fail", "data"]}},
            "not": {"anyOf": [{"required": ["tries"]}, {"required": ["min"]}]}
          }
        ]
      }
    },
    "trigger": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "kind": {"type": "string", "enum": ["manual", "source", "schedule", "event"]},
          "source": {"type": "string", "minLength": 1},
          "every": {"type": "string", "minLength": 1},
          "cron": {"type": "string", "minLength": 1},
          "event": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            ]
          },
          "rule": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "label": {"type": "string"},
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "params": {"type": "object"},
          "repo": {"type": "string"},
          "ticket": {"type": "string"},
          "adw": {"type": "string"},
          "dry_run": {"type": "boolean"},
          "repos": {"type": "array", "items": {"type": "string"}},
          "watch": {"type": "array", "items": {"type": "string"}},
          "branch": {"type": "string"},
          "jql": {"type": "string"},
          "limit": {"type": "integer"},
          "on_update": {"type": "boolean"},
          "path": {"type": "string"},
          "pattern": {"type": "string"},
          "command": {"type": "string"},
          "timeout": {"type": "number"},
          "trust": {"type": "string"},
          "tracker": {"type": "string"},
          "loop": {"type": "string"},
          "run_at_load": {"type": "boolean"},
          "repaired_by": {"type": "boolean"},
          "group": {"type": "string"}
        },
        "required": ["id", "kind"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "name"],
  "additionalProperties": false,
  "oneOf": [
    {"required": ["steps"], "not": {"anyOf": [{"required": ["node"]}, {"required": ["wire"]}]}},
    {"required": ["node"], "not": {"required": ["steps"]}}
  ]
}
